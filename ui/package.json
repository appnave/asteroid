{
  "name": "@bildvitta/quasar-ui-asteroid",
  "description": "Asteroid",
  "version": "3.20.0-beta.18-alpha.1",
  "author": "Bild & Vitta <systemteam@bild.com.br>",
  "license": "MIT",
  "main": "./src/asteroid.js",
  "unpkg": "dist/asteroid.umd.min.js",
